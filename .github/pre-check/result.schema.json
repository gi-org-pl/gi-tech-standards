{
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "summary", "decisions", "findings", "checked", "not_checked", "qa"],
  "properties": {
    "result": { "type": "string", "enum": ["passed", "changes"] },
    "summary": { "type": "string" },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_structures", "state", "api_contracts", "ux_behaviours", "new_dependencies", "architecture"],
      "properties": {
        "data_structures": { "type": "array", "items": { "type": "string" } },
        "state": { "type": "array", "items": { "type": "string" } },
        "api_contracts": { "type": "array", "items": { "type": "string" } },
        "ux_behaviours": { "type": "array", "items": { "type": "string" } },
        "new_dependencies": { "type": "array", "items": { "type": "string" } },
        "architecture": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "path", "title", "comment"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "non-blocking"] },
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "title": { "type": "string" },
          "comment": { "type": "string", "enum": ["new", "earlier", "none"] }
        }
      }
    },
    "checked": { "type": "array", "items": { "type": "string" } },
    "not_checked": { "type": "array", "items": { "type": "string" } },
    "qa": { "type": "array", "items": { "type": "string" } }
  }
}
